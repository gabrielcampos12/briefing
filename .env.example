# --- Discord (obrigatório) ---
# Crie em https://discord.com/developers/applications — bot precisa de "Message Content Intent"
# e permissão de enviar DMs. Convide o bot ao servidor com escopos: bot + applications.commands
DISCORD_BOT_TOKEN=your_token_here
# Opcional: ID do servidor para sync rápido dos comandos (desenvolvimento)
DISCORD_GUILD_ID=0

# --- LLM provider (Agno) ---
# Supported: groq
LLM_PROVIDER=groq
# Preferred generic key:
LLM_API_KEY=
# Provider-specific fallback key (optional if LLM_API_KEY is set):
GROQ_API_KEY=

# Model id used by Groq.
# Examples: llama-3.3-70b-versatile, llama-3.1-8b-instant
LLM_MODEL_ID=llama-3.3-70b-versatile

# --- Banco (local, sem Docker) ---
DATABASE_URL=postgresql+asyncpg://news:news@localhost:5432/news_briefing

# No docker-compose, DATABASE_URL é injetada automaticamente.

# --- E-mail (recomendado; sem isso, briefing só no Discord) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Horário do briefing (fuso: America/Sao_Paulo) ---
BRIEFING_SCHEDULE_HOUR=7
BRIEFING_SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=America/Sao_Paulo

# Opcional: Postgresql via compose
POSTGRES_USER=news
POSTGRES_PASSWORD=news
POSTGRES_DB=news_briefing
